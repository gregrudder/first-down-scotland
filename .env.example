# Optional. Required in production if you want the /api/revalidate
# route (and Vercel Cron) to stay private.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional. Used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override for the Community “Join the Discord” button.
# Default (used when unset): https://discord.gg/KcQTNFHjM
# Must be a discord.gg or discord.com URL, or the default is used instead.
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/KcQTNFHjM
