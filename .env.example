# Optional. Required in production if you want the /api/revalidate
# route (and Vercel Cron) to stay private.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional. Used for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Public Discord invite for the Community page CTA.
# Example: https://discord.gg/your-invite
# If unset, the page shows “Invite link coming soon” instead of a dead link.
NEXT_PUBLIC_DISCORD_INVITE=
