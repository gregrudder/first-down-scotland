# Optional. Required in production if you want the /api/revalidate
# route (and Vercel Cron) to stay private.
# Vercel Cron sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Optional. Canonical / Open Graph / sitemap origin.
# Production fallback (if unset on Vercel) is https://www.firstdownscotland.com.
# Preview deployment URLs are ignored so robots.txt does not point at SSO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override. /community already joins https://discord.gg/dVuNUT4Cgf.
# Set this only if you need a different valid discord.gg / discord.com invite.
# NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/dVuNUT4Cgf

# Optional. Overrides the Watch near you bar-owner mailto.
# NEXT_PUBLIC_CONTACT_EMAIL=info@g4-marketing.net

# Feedback form (/feedback → POST /api/feedback).
# Launch list (/ → POST /api/launch) uses a *second* Formspree form.
# Do not put inbox addresses in NEXT_PUBLIC_* — they must stay server-only.
# Do not reuse FORMSPREE_FORM_ID for the launch list.
# On Vercel Hobby, Formspree is the simple path (form id or full form URL).
# FORMSPREE_FORM_ID=
# LAUNCH_FORMSPREE_FORM_ID=
# RESEND_API_KEY=
# FEEDBACK_TO_EMAIL=
# FEEDBACK_FROM_EMAIL=First Down Scotland <hello@your-verified-domain>

# Optional. YouTube Data API v3 key (server-only). When set, live and final
# game cards try to embed an official NFL / club highlight. Without it, cards
# fall back to the NFL YouTube search link. Never NEXT_PUBLIC_*.
# YOUTUBE_API_KEY=

# --- NFL UK Fan Map (/fan-map) ---
# Vercel Postgres / Neon connection string (any one of these works).
# The app creates tables on first use. Build still succeeds if unset:
# the public map shows an honest empty state and no demo fans.
# DATABASE_URL=postgresql://...
# POSTGRES_URL=postgresql://...

# Signs fan-map session cookies. Required in production to send magic links.
# AUTH_SECRET is also accepted (Auth.js convention).
# FAN_MAP_AUTH_SECRET=
# AUTH_SECRET=

# Magic-link email. Reuses RESEND_API_KEY. From-address can be the feedback
# sender or a dedicated one. Locally, if Resend is unset, the link is logged.
# FAN_MAP_FROM_EMAIL=First Down Scotland <hello@your-verified-domain>

# Private /admin/fan-map password. Not in the public nav.
# FAN_MAP_ADMIN_SECRET=

# Optional. Towns below this count hide per-team splits. Default 3.
# FAN_MAP_PRIVACY_THRESHOLD=3

# Optional. Better UK town autocomplete than the free Photon/Nominatim fallback.
# GEOAPIFY_API_KEY=

# Optional. MapLibre style URL. Default is OpenFreeMap dark (no key).
# NEXT_PUBLIC_FAN_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# No env vars for Vercel Web Analytics or Speed Insights. Enable them in the
# Vercel project dashboard (Analytics, then Speed Insights) after deploy.
# The packages are no-ops in local next dev.
